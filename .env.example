# Server Configuration
PORT=3000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/email_sender

# Redis Configuration (Used by BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
# Generate a secure random string (e.g., using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here

# Email Provider (SMTP)
# For local testing, you can use Mailtrap (https://mailtrap.io)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
EMAIL_FROM=no-reply@yourapp.com